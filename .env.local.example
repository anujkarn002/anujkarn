# Sanity (blog) — from your project at sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Read-only token, only needed for the scheduled dataset backup (src/app/api/cron/sanity-backup)
SANITY_API_TOKEN=

# Neon (contact message log) — run sql/schema.sql once before using
DATABASE_URL=

# Vercel Blob (Sanity dataset backups).
# Preferred: run `vercel link` then `vercel storage connect <store> --auth oidc --yes` —
# this writes BLOB_STORE_ID (below) instead and the SDK authenticates via short-lived
# OIDC tokens, so no static secret needs to live in this file or the Vercel dashboard.
BLOB_STORE_ID=
# Fallback only if you're not using `vercel link`/OIDC locally:
# BLOB_READ_WRITE_TOKEN=

# Discord webhook for the contact form
DISCORD_WEBHOOK_URL=


# Optional: protects /api/cron/sanity-backup, must match the value Vercel Cron sends
CRON_SECRET=
